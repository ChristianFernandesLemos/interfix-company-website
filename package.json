{
  "name": "interfix-company-website",
  "version": "1.0.0",
  "description": "Site institucional da InterFix: suporte técnico e gestão de chamados, com formulário de contato integrado a uma API Node.js/Express.",
  "private": true,
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianFernandesLemos/interfix-company-website.git"
  },
  "keywords": [
    "interfix",
    "suporte-tecnico",
    "gestao-de-chamados",
    "express",
    "nodejs"
  ],
  "author": "Christian Fernandes Lemos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChristianFernandesLemos/interfix-company-website/issues"
  },
  "homepage": "https://github.com/ChristianFernandesLemos/interfix-company-website#readme",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
